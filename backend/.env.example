PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# PayPulse will automatically fallback to an in-memory double-entry store if PostgreSQL is unreachable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paypulse_ai
FORCE_MEMORY_DB=false

# Redis Configuration (BullMQ & Idempotency)
# PayPulse will automatically fallback to in-memory async processing if Redis is unreachable
REDIS_URL=redis://localhost:6379
FORCE_MEMORY_REDIS=false

# Razorpay API Keys (Mock mode active if left default or blank)
RAZORPAY_KEY_ID=rzp_test_mock_paypulse
RAZORPAY_KEY_SECRET=mock_secret_key_paypulse_12345
RAZORPAY_WEBHOOK_SECRET=paypulse_webhook_secret_hmac_256

# AI Microservice URL (FastAPI)
AI_SERVICE_URL=http://localhost:8000
